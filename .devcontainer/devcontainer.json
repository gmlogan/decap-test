{
  "name": "loganvantravels (Hugo)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/hugo:1": {
      "extended": true,
      "version": "0.165.0"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["eliostruyf.vscode-front-matter"]
    }
  },
  "postCreateCommand": "git submodule update --init --recursive",
  "forwardPorts": [1313],
  "portsAttributes": {
    "1313": {
      "label": "Hugo preview",
      "onAutoForward": "openPreview"
    }
  }
}
