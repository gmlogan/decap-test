{
  "$schema": "https://frontmatter.codes/frontmatter.schema.json",
  "frontMatter.framework.id": "hugo",
  "frontMatter.content.publicFolder": "static",
  "frontMatter.preview.host": "http://localhost:1313",
  "frontMatter.taxonomy.dateFormat": "yyyy-MM-dd",
  "frontMatter.content.defaultFilePrefix": "{{year}}-{{month}}-{{day}}",
  "frontMatter.content.autoUpdateDate": false,
  "frontMatter.content.pageFolders": [
    {
      "title": "posts",
      "path": "[[workspace]]/content/posts",
      "contentTypes": ["post"],
      "filePrefix": "{{year}}-{{month}}-{{day}}"
    }
  ],
  "frontMatter.taxonomy.contentTypes": [
    {
      "name": "post",
      "pageBundle": true,
      "clearEmpty": true,
      "previewPath": null,
      "fields": [
        { "title": "Title", "name": "title", "type": "string", "required": true },
        {
          "title": "Trip date",
          "name": "date",
          "type": "datetime",
          "dateFormat": "yyyy-MM-dd",
          "default": "{{now}}",
          "isPublishDate": true,
          "required": true
        },
        { "title": "Draft", "name": "draft", "type": "draft", "default": false },
        { "title": "Slug (URL)", "name": "slug", "type": "slug", "editable": true },
        {
          "title": "Original blog date",
          "name": "wp_published",
          "type": "datetime",
          "dateFormat": "yyyy-MM-dd"
        }
      ]
    },
    {
      "name": "default",
      "pageBundle": false,
      "previewPath": null,
      "fields": [
        { "title": "Title", "name": "title", "type": "string" },
        { "title": "Is in draft", "name": "draft", "type": "draft" }
      ]
    }
  ]
}
